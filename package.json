{
  "name": "profile-site",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "npm run copy:cms:local && astro dev",
    "build": "npm run copy:cms && astro build",
    "build:prod": "npm run copy:cms && astro build",
    "preview": "astro preview",
    "copy:cms": "powershell -Command \"New-Item -ItemType Directory -Force -Path public/admin | Out-Null; Copy-Item src/cms/config.yml public/admin/config.yml -Force\"",
    "copy:cms:local": "powershell -Command \"New-Item -ItemType Directory -Force -Path public/admin | Out-Null; Copy-Item src/cms/config.local.yml public/admin/config.yml -Force\"",
    "cms:proxy": "npx decap-server",
    "lint": "eslint src --ext .astro,.ts,.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{astro,ts,js,json,md}\""
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.0",
    "@astrojs/sitemap": "^3.2.0",
    "astro": "^5.0.0",
    "decap-cms": "^3.0.0",
    "decap-server": "^3.0.1",
    "js-yaml": "^4.1.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/tailwind": "^5.1.0",
    "@iconify-json/logos": "^1.2.11",
    "@iconify-json/mdi": "^1.2.3",
    "@iconify-json/tabler": "^1.2.38",
    "@iconify-json/vscode-icons": "^1.2.68",
    "@rollup/plugin-yaml": "^5.0.0",
    "@tailwindcss/typography": "^0.5.15",
    "@types/js-yaml": "^4.0.9",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "astro-eslint-parser": "^1.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-astro": "^1.0.0",
    "prettier": "^3.3.0",
    "prettier-plugin-astro": "^0.14.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.5.0"
  }
}
