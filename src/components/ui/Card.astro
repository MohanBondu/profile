---
interface Props {
  children: any;
  class?: string;
  href?: string;
  image?: string;
  imageAlt?: string;
  'data-tags'?: string;
  [key: `data-${string}`]: string | undefined;
}
const { children, class: className, href, image, imageAlt, ...rest } = Astro.props;
const baseClass = `overflow-hidden rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 ${className || ''}`;
const linkClass = `block ${baseClass} hover:border-primary-500 dark:hover:border-primary-500 transition-colors`;
---

{href ? (
  <a href={href} class={linkClass} {...rest}>
    {image && <img src={image} alt={imageAlt || ''} class="w-full h-48 object-cover" loading="lazy" />}
    <div class="p-6">
      <slot />
    </div>
  </a>
) : (
  <div class={baseClass} {...rest}>
    {image && <img src={image} alt={imageAlt || ''} class="w-full h-48 object-cover" loading="lazy" />}
    <div class="p-6">
      <slot />
    </div>
  </div>
)}