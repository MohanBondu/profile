---
import { parseYaml, profileSchema, socialSchema } from '../../schemas';
import profileRaw from '../../data/profile.yaml';
import socialRaw from '../../data/social.yaml';
import Icon from '../ui/Icon.astro';

const profile = parseYaml(profileSchema, profileRaw);
const social = parseYaml(socialSchema, socialRaw);
---

<section class="relative min-h-[90vh] flex items-center justify-center px-4 py-20">
  <div class="max-w-4xl w-full text-center">
    <img
      src={profile.avatar}
      alt=""
      class="w-40 h-40 rounded-full mx-auto mb-6 border-4 border-gray-200 dark:border-gray-700 shadow-lg"
    />
    <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold text-gray-900 dark:text-white mb-4">
      {profile.name}
    </h1>
    <p class="text-xl md:text-2xl text-primary-600 dark:text-primary-400 font-medium mb-4">
      {profile.title}
    </p>
    <p class="text-lg md:text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-2xl mx-auto">
      {profile.tagline}
    </p>
    <div class="flex flex-wrap items-center justify-center gap-4">
      {social.links.map(link => (
        <a
          href={link.url}
          target="_blank"
          rel="noopener noreferrer"
          aria-label={link.platform}
          class="p-3 rounded-lg bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-primary-100 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
        >
          <Icon name={link.icon} width={24} height={24} />
        </a>
      ))}
    </div>
  </div>
</section>