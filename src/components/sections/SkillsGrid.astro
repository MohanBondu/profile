---
import { parseYaml, skillsSchema } from '../../schemas';
import skillsRaw from '../../data/skills.yaml';
import Icon from '../ui/Icon.astro';
import Tag from '../ui/Tag.astro';

const skills = parseYaml(skillsSchema, skillsRaw);
---

<section id="skills" class="py-20 px-4">
  <div class="mx-auto max-w-7xl">
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-12 text-center">Skills & Technologies</h2>
    <div class="space-y-12">
      {skills.categories.map(category => (
        <div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-6 flex items-center gap-2">
            <Icon name="folder" width={24} height={24} />
            {category.name}
          </h3>
          <div class="flex flex-wrap gap-3">
            {category.items.map(item => (
              <Tag variant="outline" class="gap-1.5">
                <Icon name={item.icon} width={16} height={16} />
                {item.name}
              </Tag>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>