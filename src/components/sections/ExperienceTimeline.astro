---
import { parseYaml, experienceSchema } from '../../schemas';
import experienceRaw from '../../data/experience.yaml';
import Card from '../ui/Card.astro';
import Badge from '../ui/Badge.astro';
import Tag from '../ui/Tag.astro';
import Icon from '../ui/Icon.astro';

const { experience } = parseYaml(experienceSchema, experienceRaw);
const publishedExperience = experience.filter(e => e.status === 'published');
---

<section id="experience" class="py-20 px-4 bg-gray-50 dark:bg-gray-900">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-12 text-center">Experience</h2>
    <div class="relative">
      <!-- Timeline line -->
      <div class="absolute left-8 top-0 bottom-0 w-0.5 bg-gray-200 dark:bg-gray-700" aria-hidden="true"></div>

      <div class="space-y-12">
        {publishedExperience.map((job, index) => (
          <div class="relative pl-20">
            <!-- Timeline dot -->
            <div class="absolute left-4 top-2 w-10 h-10 flex items-center justify-center">
              <div class="w-4 h-4 rounded-full bg-primary-600 border-4 border-white dark:border-gray-900 shadow-lg" aria-hidden="true"></div>
            </div>

            <Card class="relative">
              <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4 mb-4">
                <div>
                  <h3 class="text-xl font-semibold text-gray-900 dark:text-white">{job.role}</h3>
                  <p class="text-primary-600 dark:text-primary-400 font-medium mt-1">{job.company}</p>
                </div>
                <div class="flex flex-wrap items-center gap-2 text-sm text-gray-500 dark:text-gray-400">
                  <span class="flex items-center gap-1">
                    <Icon name="map-pin" width={14} height={14} />
                    {job.location}
                  </span>
                  <Badge variant="secondary">{job.type}</Badge>
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2 mb-4 text-sm text-gray-500 dark:text-gray-400">
                <span class="flex items-center gap-1">
                  <Icon name="calendar" width={14} height={14} />
                  {new Date(job.startDate + '-01').toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
                  {' '}–{' '}
                  {job.endDate
                    ? new Date(job.endDate + '-01').toLocaleDateString('en-US', { month: 'short', year: 'numeric' })
                    : 'Present'}
                </span>
                <span class="flex items-center gap-1">
                  <Icon name="clock" width={14} height={14} />
                  {job.endDate
                    ? `${Math.round((new Date(job.endDate + '-01').getTime() - new Date(job.startDate + '-01').getTime()) / (1000 * 60 * 60 * 24 * 30))} months`
                    : 'Current'}
                </span>
              </div>

              {job.skills.length > 0 && (
                <div class="flex flex-wrap gap-2 mb-4">
                  {job.skills.map(skill => (
                    <Tag variant="outline" key={skill}>{skill}</Tag>
                  ))}
                </div>
              )}

              {job.highlights.length > 0 && (
                <ul class="space-y-2">
                  {job.highlights.map(highlight => (
                    <li class="flex items-start gap-3 text-gray-600 dark:text-gray-300">
                      <Icon name="check-circle" width={20} height={20} class="flex-shrink-0 text-primary-600 dark:text-primary-400 mt-0.5" />
                      <span>{highlight}</span>
                    </li>
                  ))}
                </ul>
              )}
            </Card>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>