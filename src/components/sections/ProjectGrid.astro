---
import { parseYaml, projectsSchema } from '../../schemas';
import projectsRaw from '../../data/projects.yaml';
import Card from '../ui/Card.astro';
import Tag from '../ui/Tag.astro';
import Badge from '../ui/Badge.astro';

const { projects } = parseYaml(projectsSchema, projectsRaw);
const publishedProjects = projects.filter(p => p.status === 'published');
const featuredProjects = publishedProjects.filter(p => p.featured);
const otherProjects = publishedProjects.filter(p => !p.featured);

interface Props {
  featured?: boolean;
  limit?: number;
}
const { featured = false, limit } = Astro.props;

const displayProjects = featured ? featuredProjects : otherProjects;
const limitedProjects = limit ? displayProjects.slice(0, limit) : displayProjects;
---

<section id="projects" class="py-20 px-4">
  <div class="mx-auto max-w-7xl">
    {!featured && (
      <>
        <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-8 text-center">Projects</h2>
        <div class="flex flex-wrap gap-2 mb-12 justify-center" id="project-filters">
          {['All', ...new Set(publishedProjects.flatMap(p => p.stack))].map(tag => (
            <button
              class="px-4 py-2 text-sm font-medium rounded-full bg-gray-100 dark:bg-gray-800 text-gray-700 dark:text-gray-300 hover:bg-primary-100 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 transition-all duration-200 border border-transparent hover:border-primary-300 dark:hover:border-primary-700"
              data-filter={tag}
              type="button"
            >
              {tag}
            </button>
          ))}
        </div>
      </>
    )}

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="projects-grid">
      {limitedProjects.map(project => (
        <Card
          image={project.image}
          imageAlt={project.title}
          class="group project-card transition-all duration-300 hover:shadow-xl hover:-translate-y-1"
          data-tags={project.stack.join(',')}
        >
          <div class="flex items-start justify-between gap-2 mb-3">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
              {project.title}
            </h3>
            {project.featured && <Badge variant="success">Featured</Badge>}
          </div>
          <p class="text-gray-600 dark:text-gray-400 text-sm mb-4 line-clamp-3">
            {project.description}
          </p>
          <div class="flex flex-wrap gap-2 mb-4">
            {project.stack.slice(0, 5).map(tech => (
              <Tag variant="secondary" key={tech}>{tech}</Tag>
            ))}
            {project.stack.length > 5 && (
              <Tag variant="outline">+{project.stack.length - 5} more</Tag>
            )}
          </div>
          <div class="flex flex-wrap gap-3">
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline flex items-center gap-1"
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 0C5.374 0 0 5.373 0 12c0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.305-.536-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0112 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
                Code
              </a>
            )}
            {project.demo && (
              <a
                href={project.demo}
                target="_blank"
                rel="noopener noreferrer"
                class="text-sm font-medium text-primary-600 dark:text-primary-400 hover:underline flex items-center gap-1"
              >
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"/></svg>
                Demo
              </a>
            )}
          </div>
        </Card>
      ))}
    </div>

    {!featured && otherProjects.length > (limit || 6) && (
      <div class="text-center mt-10">
        <a href="/projects" class="inline-flex items-center px-6 py-3 text-base font-medium text-white bg-primary-600 rounded-lg hover:bg-primary-700 transition-colors">
          View All Projects
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    )}
  </div>
</section>

<script>
  // Filter functionality - runs after DOM is ready
  function initProjectFilters() {
    const filterButtons = document.querySelectorAll('#project-filters button[data-filter]');
    const projectCards = document.querySelectorAll('#projects-grid .project-card');
    
    if (filterButtons.length === 0 || projectCards.length === 0) return;
    
    filterButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.dataset.filter;
        projectCards.forEach(card => {
          const tags = card.dataset.tags || '';
          const hasTag = tags.split(',').some(t => t.trim() === filter);
          if (filter === 'All' || hasTag) {
            card.style.display = '';
            card.style.animation = 'fadeIn 0.3s ease-out';
          } else {
            card.style.display = 'none';
          }
        });
        // Update active button
        filterButtons.forEach(b => {
          b.classList.remove('bg-primary-600', 'text-white', 'border-primary-600');
          b.classList.add('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
        });
        btn.classList.remove('bg-gray-100', 'dark:bg-gray-800', 'text-gray-700', 'dark:text-gray-300');
        btn.classList.add('bg-primary-600', 'text-white', 'border-primary-600');
      });
    });
  }
  
  // Run on DOM ready
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initProjectFilters);
  } else {
    initProjectFilters();
  }
</script>

<style>
  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  
  .project-card {
    animation: fadeIn 0.3s ease-out;
  }
  
  #project-filters button:focus {
    outline: none;
    box-shadow: 0 0 0 2px #fff, 0 0 0 4px #0ea5e9;
  }
</style>