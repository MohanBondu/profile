---
import { parseYaml, profileSchema, socialSchema } from '../../schemas';
import profileRaw from '../../data/profile.yaml';
import socialRaw from '../../data/social.yaml';
import Icon from '../ui/Icon.astro';

const profile = parseYaml(profileSchema, profileRaw);
const social = parseYaml(socialSchema, socialRaw);
---

<section id="contact" class="py-20 px-4">
  <div class="mx-auto max-w-4xl">
    <h2 class="text-3xl font-bold text-gray-900 dark:text-white mb-4 text-center">Get In Touch</h2>
    <p class="text-gray-600 dark:text-gray-400 text-center mb-12 max-w-2xl mx-auto">
      I'm always open to discussing new projects, creative ideas, or opportunities to be part of your vision.
      Feel free to reach out through any of the channels below.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-12">
      <!-- Email Card -->
      <a
        href={`mailto:${profile.email}`}
        class="card group p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
      >
        <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/30 flex items-center justify-center mb-4">
          <Icon name="mail" width={24} height={24} class="text-primary-600 dark:text-primary-400" />
        </div>
        <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">Email Me</h3>
        <p class="text-gray-600 dark:text-gray-400">{profile.email}</p>
        <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">Opens your default email client</p>
      </a>

      <!-- Resume Card -->
      {profile.resume && (
        <a
          href={profile.resume}
          target="_blank"
          rel="noopener noreferrer"
          class="card group p-6 rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-900 hover:border-primary-500 dark:hover:border-primary-500 transition-colors"
        >
          <div class="w-12 h-12 rounded-lg bg-green-100 dark:bg-green-900/30 flex items-center justify-center mb-4">
            <Icon name="file-text" width={24} height={24} class="text-green-600 dark:text-green-400" />
          </div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-2">View Resume</h3>
          <p class="text-gray-600 dark:text-gray-400">Download my full resume (PDF)</p>
          <p class="text-xs text-gray-500 dark:text-gray-500 mt-2">Opens in new tab</p>
        </a>
      )}
    </div>

    <!-- Social Links -->
    <div class="text-center">
      <h3 class="text-lg font-medium text-gray-900 dark:text-white mb-6">Or connect with me</h3>
      <div class="flex flex-wrap items-center justify-center gap-4">
        {social.links.filter(l => l.platform !== 'Email').map(link => (
          <a
            href={link.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={link.platform}
            class="p-3 rounded-xl bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400 hover:bg-primary-100 dark:hover:bg-primary-900/30 hover:text-primary-600 dark:hover:text-primary-400 transition-colors group"
          >
            <Icon name={link.icon} width={24} height={24} />
          </a>
        ))}
      </div>
    </div>
  </div>
</section>